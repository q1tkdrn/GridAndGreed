    type: 1
    target: "\uC55E\uC73C\uB85C"
    fromPhase: 2
    toPhase: 2
    text: "\uAE38\uACE0 \uAE34 \uC5EC\uD589\uC744 \uB5A0\uB0A0\uAC70\uC57C."
  - id: NPC_060
    groupId: 12
    npcName: "\uB9B4\uB9AC"
    type: 1
    target: 
    fromPhase: 2
    toPhase: 2
    text: "\uC774\uC81C \uAC00\uACE0 \uC2F6\uC740 \uACF3\uC774 \uC0DD\uACBC\uAC70\uB4E0."
  - id: NPC_061
    groupId: 12
    npcName: "\uB9B4\uB9AC"
    type: 1
    target: 
    fromPhase: 2
    toPhase: 2
    text: "\uAC71\uC815\uD558\uC9C0 \uB9C8. \uADF8\uBD84\uC744 \uB2E4\uC2DC \uBCF4\uC9C0
      \uBABB\uD560 \uAC70\uB780 \uAC74 \uC798 \uC54C\uACE0 \uC788\uC73C\uB2C8\uAE4C."
  - id: NPC_062
    groupId: 13
    npcName: "\uB9B4\uB9AC"
    type: 2
    target: "\uC0AC\uC81C"
    fromPhase: 0
    toPhase: 2
    text: "\uC88B\uC740 \uB140\uC11D\uC774\uC9C0. \uB108\uBB34 \uACE0\uC9C0\uC2DD\uD558\uAE34
      \uD558\uC9C0\uB9CC."
  - id: NPC_063
    groupId: 14
    npcName: "\uB9B4\uB9AC"
    type: 2
    target: "\uBB34\uD76C"
    fromPhase: 0
    toPhase: 2
    text: "\uBD99\uC784\uC131\uC774 \uC88B\uC740 \uB140\uC11D\uC774\uC57C. \uB3C4\uC6C0\uC774
      \uB420 \uAC70\uC57C."
  - id: NPC_064
    groupId: 15
    npcName: "\uB9B4\uB9AC"
    type: 2
    target: "\uB9C8\uBC95\uC0AC"
    fromPhase: 0
    toPhase: 2
    text: "\uB140\uC11D\uC758 \uB9C8\uBC95\uC740 \uB098\uC870\uCC28\uB3C4 \uB180\uB784
      \uB54C\uAC00 \uC788\uC5B4."
  - id: NPC_065
    groupId: 16
    npcName: "\uB9B4\uB9AC"
    type: 2
    target: "\uC2A4\uCE90\uBE48\uC800"
    fromPhase: 0
    toPhase: 2
    text: "\uC774\uAC83\uC800\uAC83 \uC8FC\uC6CC \uC624\uB294\uB370\u2026 \uAC78\uB7EC\uC11C
      \uBC1B\uB294 \uAC8C \uC88B\uC744 \uAC70\uC57C."
  - id: NPC_066
    groupId: 17
    npcName: "\uB9B4\uB9AC"
    type: 2
    target: "\uAD11\uC2E0\uB3C4"
    fromPhase: 0
    toPhase: 2
    text: "\uAC00\uB054 \uBB34\uC2A8 \uB9D0\uC744 \uD558\uB294\uC9C0 \uBAA8\uB974\uACA0\uC9C0\uB9CC\u2026
      \uAD1C\uCC2E\uC740 \uB140\uC11D\uC774\uC57C."
  - id: NPC_067
    groupId: 18
    npcName: "\uB9B4\uB9AC"
