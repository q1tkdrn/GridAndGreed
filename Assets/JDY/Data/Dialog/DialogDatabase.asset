    groupId: 122
    npcName: "\uD788\uC544\uC2E0\uC2A4"
    type: 1
    target: 
    fromPhase: 2
    toPhase: 2
    text: "\"\uC800\uB294 \uC544\uC9C1\u2026. \uC800\uAC83\uC744 \uBB34\uC5C7\uC774\uB77C\uACE0
      \uBD88\uB7EC\uC57C \uD558\uB294\uC9C0\uB3C4 \uBAA8\uB974\uACA0\uC5B4\uC694.\""
