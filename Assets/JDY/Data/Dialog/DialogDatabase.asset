    text: "\"\uADF8\uB140\uC758 \uAE30\uC5B5\uC744 \uCC3E\uC544\uBCF4\uB824 \uD574\uB3C4\u2026.\""
  - id: NPC_359
    groupId: 122
    npcName: "\uD788\uC544\uC2E0\uC2A4"
    type: 1
    target: 
    fromPhase: 2
    toPhase: 2
    text: "\"\uB05D\uC5C6\uC774 \uBC1D\uC740 \uBE5B\uB9CC \uAC00\uB4DD\uD560 \uBFD0,
      \uADF8 \uC5B4\uB290 \uAC83\uB3C4 \uBCF4\uC774\uC9C8 \uC54A\uC544\uC694.\""
  - id: NPC_360
    groupId: 122
    npcName: "\uD788\uC544\uC2E0\uC2A4"
    type: 1
    target: 
    fromPhase: 2
    toPhase: 2
    text: "\"\uC544\uC2A4\uD3EC\uB378\uACFC\uB294 \uB2E4\uB978 \uAE30\uCC99\uC774\uC5D0\uC694..
      \uC544\uB2C8 \uC560\uCD08\uC5D0 \uC800\uD76C\uC640\uB294 \uADFC\uBCF8\uC801\uC73C\uB85C
      \uB2E4\uB978..\""
  - id: NPC_361
    groupId: 122
    npcName: "\uD788\uC544\uC2E0\uC2A4"
    type: 1
    target: 
    fromPhase: 2
    toPhase: 2
    text: "\"\uC774\uC9C8\uAC10\u2026 \uBE5B \uB108\uBA38\uC5D0 \uB204\uAD70\uAC00
      \uC788\uC5B4\uC694.\""
  - id: NPC_362
