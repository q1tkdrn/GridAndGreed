    npcName: "\uD788\uC544\uC2E0\uC2A4"
    type: 1
    target: 
    fromPhase: 2
    toPhase: 2
    text: "\"\uC9C0\uAE08\uAE4C\uC9C0 \uB2F9\uC2E0\uC774 \uACBD\uD5D8\uD55C \uC790\uB4E4\uACFC\uB294
      \uB2E4\uB978...\""
