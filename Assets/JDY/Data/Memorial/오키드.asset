  m_Script: {fileID: 11500000, guid: 94063991e89fca1499cf00d3c8a3e160, type: 3}
  m_Name: "\uC624\uD0A4\uB4DC"
  m_EditorClassIdentifier: Assembly-CSharp::MemorialData
  memorialName: "\uC624\uD0A4\uB4DC"
  id: 6
  contents:
  - images: {fileID: 21300000, guid: 07e2987b5ad1976449bb756503b6ae1e, type: 3}
    descriptions:
    - "(\uB208\uC744 \uAC10\uACE0, \uB2F9\uC2E0\uC740 \uC624\uD0A4\uB4DC\uC758 \uAE30\uC5B5
      \uD55C\uD3B8\uC744 \uB4E4\uC5EC\uB2E4 \uBCF8\uB2E4.)"
  - images: {fileID: 21300000, guid: c11307be070384c4b8924b104bc2690d, type: 3}
    descriptions:
    - "(\uB208\uC744 \uB72C \uB2F9\uC2E0\uC758 \uC55E\uC5D0\uB294....)\r\n(\uD55C
      \uB0A8\uC790\uAC00 \uC4F0\uB7EC\uC838 \uC788\uC5C8\uB2E4.)\r\n\".....\"\r\n\"\uC774
      \uB0A8\uC790\uC778\uAC00?\"\r\n\"\uB85C\uC988, \uB4E4\uB824?\""
    - "\"...\"\r\n\"..... \uB4E4\uB824\uC694! \uC120\uBC30\uB2D8.\"\r\n\"\uC2DC\uCCB4\uB294
      \uCC3E\uC558\uACE0, \uC774\uC81C \uBB50\uD558\uBA74 \uB41C\uB2E4\uACE0?\"\r\n\"\uB124!
      \uC81C\uAC00 \uB4DC\uB9B0 \uCC9C\uC218\uAD6D\uC744 \uB4E4\uACE0 \uADF8 \uC55E\uC5D0
      \uC11C \uBCF4\uC2DC\uACA0\uC5B4\uC694?.\"\r\n(\uB2F9\uC2E0, \uC544\uB2C8 \uC624\uD0A4\uB4DC\uB294
      \uC2F8\uB298\uD55C \uC2DC\uCCB4 \uC55E\uC5D0 \uC130\uB2E4.)"
    - "\"\uADF8 \uB2E4\uC74C\uC740?\"\r\n(\uC800 \uB108\uBA38\uC758 \uBAA9\uC18C\uB9AC\uB294
      \uB2F9\uC2E0\uC5D0\uAC8C \uC218\uB9CE\uC740 \uC808\uCC28\uC640 \uC8FC\uC758\uC0AC\uD56D\uC744
      \uB9D0\uD574 \uC8FC\uC5C8\uB2E4.)"
    - "\"...\"\r\n\"\uC544. \uC774\uC81C \uAE30\uC5B5\uB0AC\uB124.\"\r\n\"\uC54C\uACA0\uC5B4.
      \uB05D\uB098\uBA74 \uBCF4\uACE0\uD560\uAC8C.\"\r\n\"\uB135! \uC54C\uACA0\uC2B5\uB2C8\uB2E4!\""
    - "\"...\"\n\"\uC120\uBC30\uB2D8. \uD2B9\uD788\uB098 \uB9DD\uC790\uB97C \uC0AC\uC2E0\uC73C\uB85C
      \uB418\uC0B4\uB9AC\uB294 \uD589\uC704\uB294..\"\r\n\"\uC791\uC740 \uC2E4\uC218
      \uD558\uB098\uB77C\uB3C4 \uC788\uC73C\uBA74 \uC548\uB418\uB294\uAC70 \uC544\uC2DC\uC8E0..?\"\r\n\"\uD639\uC2DC\uB098
      \uADF8 \uC120\uBC30\uB2D8\uCC98\uB7FC...\""
    - "\"\uC54C\uC544.\"\r\n\"\uB09C \uC2E4\uC218\uAC19\uC740\uAC74 \uD558\uC9C0
      \uC54A\uC544.\"\r\n\"....\uB124 \uC54C\uACA0\uC5B4\uC694.\"\r\n(\uB2F9\uC2E0\uC740
      \uD1B5\uC2E0\uC744 \uB04A\uACE0, \uB5A8\uB9AC\uB294 \uB9C8\uC74C\uC73C\uB85C
      \uBC14\uB2E5\uC5D0 \uBE5B\uC870\uAC01\uC744 \uB193\uC558\uB2E4.)"
    - "(\uBC14\uB78C\uC774 \uBD88\uC9C0 \uC54A\uB3C4\uB85D \uC7A5\uB9C9\uC744 \uB450\uB974\uACE0,)\r\n(\uADF8
      \uB0A8\uC790\uC640 \uBE5B\uC870\uAC01 \uC0AC\uC774\uC5D0 \uCC9C\uC218\uAD6D\uC744
      \uC0B4\uD3EC\uC2DC \uB0B4\uB824\uB193\uC558\uB2E4.)"
  - images: {fileID: 21300000, guid: 07e2987b5ad1976449bb756503b6ae1e, type: 3}
    descriptions:
    - "(.....)\r\n(\uB2F9\uC2E0\uC740...)\r\n(\uB2F9\uC2E0\uC740 \uB208\uC744 \uB5A0
      \uD55C\uD3B8\uC758 \uCD94\uC5B5\uC5D0\uC11C \uBC1C\uC744 \uBE7C\uB0C8\uB2E4.)"
