  m_Script: {fileID: 11500000, guid: 94063991e89fca1499cf00d3c8a3e160, type: 3}
  m_Name: "\uC544\uC2A4\uD3EC\uB378"
  m_EditorClassIdentifier: Assembly-CSharp::MemorialData
  memorialName: "\uC544\uC2A4\uD3EC\uB378"
  id: 4
  contents:
  - images: {fileID: 21300000, guid: 07e2987b5ad1976449bb756503b6ae1e, type: 3}
    descriptions:
    - "(\uB208\uC744 \uAC10\uACE0, \uB2F9\uC2E0\uC740 \uC544\uC2A4\uD3EC\uB378\uC758
      \uAE30\uC5B5 \uD55C\uD3B8\uC744 \uB4E4\uC5EC\uB2E4 \uBCF8\uB2E4.)"
  - images: {fileID: 21300000, guid: b4837d63e6bffbb41b63e2e105a4dd29, type: 3}
    descriptions:
    - "(\uB2F9\uC2E0 \uACC1\uC5D0\uB294 \uC774\uC81C \uB9C9 \uC8FD\uC740 \uB9DD\uC790\uAC00
      \uC11C \uC788\uC5C8\uB2E4.)\r\n\".....\uC800..\uB294 \uC774\uC81C \uC8FD\uC740\uAC74\uAC00\uC694??\"\r\n\"\uB124.\"\r\n(\uB208
      \uC55E\uC758 \uB9DD\uC790\uB294 \uADF8 \uC0AC\uC2E4\uC744 \uBC1B\uC544\uB4E4\uC774\uC9C0
      \uBABB\uD574\uC11C \uD55C\uCC38\uC744 \uCDA9\uACA9\uC5D0 \uBE60\uC838 \uC6C0\uC9C1\uC774\uC9C0
      \uBABB\uD558\uC600\uB2E4.)\r\n\"....\"\r\n\"\uC774...\uC774\uC81C \uC804 \uC5B4\uB5BB\uAC8C
      \uB418\uB294 \uAC74\uAC00\uC694?\"\r\n\"\uC800\uC640 \uD568\uAED8 \uC800\uC2B9\uC73C\uB85C
      \uAC00\uC11C....\"\r\n\"\uC800...\uC800\uC2B9\uC774\uC694?\"\r\n\"\uB124. \uADF8\uACF3\uC5D0\uC11C
      \uB584\uB85C\uB294 \uC7A0\uC2DC.... \uD639\uC740 \uC601\uAC81\uC758 \uC138\uC6D4\uC744
      \uBCF4\uB0B8 \uD6C4,\"\r\n\"\uB2E4\uC2DC \uD0DC\uC5B4\uB098\uC2E4 \uC218 \uC788\uC744\uAC81\uB2C8\uB2E4.\"\r\n\"\uB2E8,\"\r\n\"\uC774\uC804\uC758
      \uC0B6\uACFC \uC800\uC2B9\uC5D0\uC11C\uC758 \uAE30\uC5B5\uC740 \uC0AC\uB77C\uC9C8\uAC81\uB2C8\uB2E4.\""
    - "(\uB208 \uC55E\uC758 \uB9DD\uC790\uB294 \uC4F0\uB7EC\uC9C4 \uC790\uC2E0\uC5D0\uAC8C\uC11C
      \uB208\uC744 \uB5BC\uC9C0 \uBABB\uD558\uACE0 \uC788\uB2E4.)\r\n\"....\"\r\n\"\uB108\uBB34
      \uAC71\uC815 \uB9C8\uC138\uC694.\"\r\n\"\uADF8\uB4E4\uC774 \uB2F9\uC2E0\uC744
      \uAE30\uC5B5\uD558\uB294 \uD55C.\"\r\n\"\uB2F9\uC2E0\uC774 \uC9C0\uAE08\uC758
      \uAE30\uC5B5\uC744 \uC78A\uAC8C \uB418\uC5B4\uB3C4.\"\r\n\"\uB2F9\uC2E0\uC740
      \uC601\uC6D0\uD788 \uB2F9\uC2E0\uC785\uB2C8\uB2E4.\""
    - "\"...\"\r\n\"\uC790, \uC77C\uB2E8 \uAC00\uC2DC\uC8E0.\"\r\n(\uBB38\uC774 \uC5F4\uB9AC\uACE0,
      \uBC1D\uC740 \uBE5B\uC774 \uB2F9\uC2E0\uACFC \uB9DD\uC790\uB97C \uAC10\uC2FC\uB2E4.)"
  - images: {fileID: 21300000, guid: 07e2987b5ad1976449bb756503b6ae1e, type: 3}
    descriptions:
    - "(....)\r\n(\uB2F9\uC2E0\uC740 \uB208\uC744 \uB5A0 \uB3CC\uC544\uC62C \uC218
      \uC5C6\uB294 \uAE30\uC5B5\uC5D0\uC11C \uBC1C\uC744 \uBE7C\uB0C8\uB2E4.)"
