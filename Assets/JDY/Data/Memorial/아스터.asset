  m_Script: {fileID: 11500000, guid: 94063991e89fca1499cf00d3c8a3e160, type: 3}
  m_Name: "\uC544\uC2A4\uD130"
  m_EditorClassIdentifier: Assembly-CSharp::MemorialData
  memorialName: "\uC544\uC2A4\uD130"
  id: 3
  contents:
  - images: {fileID: 21300000, guid: 07e2987b5ad1976449bb756503b6ae1e, type: 3}
    descriptions:
    - "(\uB208\uC744 \uAC10\uACE0, \uB2F9\uC2E0\uC740 \uC544\uC2A4\uD130\uC758 \uAE30\uC5B5
      \uD55C\uD3B8\uC744 \uB4E4\uC5EC\uB2E4 \uBCF8\uB2E4.)\r\n(....)\r\n(\uC544\uC9C1
      \uB208\uC744 \uB2EC\uC544\uC8FC\uC9C0 \uC54A\uC544\uC11C\uC778\uC9C0, \uC544\uBB34\uAC83\uB3C4
      \uBCF4\uC774\uC9C0 \uC54A\uB294\uB2E4.)\r\n(...)\r\n(\uB2F9\uC2E0\uC740 \uC5B4\uCA54\uC218
      \uC5C6\uC774 \uB4E4\uB9AC\uB294 \uBAA8\uB4E0 \uC18C\uB9AC\uC5D0 \uC9D1\uC911\uD558\uC600\uB2E4.)\r\n(\uC7AC\uBD09\uD2C0\uC774
      \uB3CC\uC544\uAC00\uB294 \uC18C\uB9AC, \uB2F4\uBC43\uC7AC\uAC00 \uB5A8\uC5B4\uC9C0\uB294
      \uC18C\uB9AC.)\r\n(\uD765\uBBF8\uB85C\uC6B4 \uC18C\uB9AC\uAC00 \uB2F9\uC2E0\uC758
      \uADC0\uB97C \uB9F4\uB3C8\uB2E4.)"
    - "\".....\"\r\n\"\uBCF4\uC5EC?\"\r\n\"....\"\r\n\"\uB300\uB2F5\uC774 \uC5C6\uB124..\"\r\n\"\uC2A4\uC2B9\uB2D8.
      \uC774\uBC88\uC5D0\uB3C4...\"\r\n(\uC544\uBB34\uB798\uB3C4 \uC544\uC2A4\uD130\uC758
      \uB208\uC744 \uB2EC\uC544\uC8FC\uB294 \uAC83\uC744 \uC78A\uC740 \uBAA8\uC591\uC774\uB2E4.)\r\n\"....\"\r\n\"\uC5EC\uAE30
      \uC788\uC2B5\uB2C8\uB2E4!!\"\r\n\"\uADF8\uB7F0\uB370...\uC5B4\uCC0C \uC544\uBB34\uAC83\uB3C4
      \uBCF4\uC774\uC9C0\uAC00 \uC54A\uB294\uAD70\uC694...!!\"\r\n\"\uC544 \uC774\uAC78
      \uC5B4\uCA4C\uBA74 \uC88B\uC9C0..!! \uC774 \uB09C\uAD00\uC744 \uC5B4\uCC0C...!\""
    - "(\uB2F9\uC2E0\uC740, \uC544\uB2C8 \uC544\uC2A4\uD130\uB294 \uD544\uC0AC\uC801\uC73C\uB85C
      \uC790\uC2E0\uC758 \uC874\uC7AC\uB97C \uC5B4\uD544\uD558\uC600\uB2E4.)\r\n(\uC5EC\uAE30\uBD80\uD134
      \uB2F9\uC2E0\uC774 \uC544\uB294 \uC544\uC2A4\uD130\uB2E4.)\r\n(\uB2F9\uC2E0\uC740
      \uAD73\uC774 \uB354 \uBCFC \uD544\uC694\uAC00 \uC5C6\uB2E4\uACE0 \uC0DD\uAC01\uD558\uC5EC)\r\n(\uAC10\uC740
      \uB450 \uB208\uC744 \uB5A0 \uD55C\uD3B8\uC758 \uAE30\uC5B5\uC5D0\uC11C \uBC1C\uC744
      \uBE7C\uB0C8\uB2E4.)"
