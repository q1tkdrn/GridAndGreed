  m_Script: {fileID: 11500000, guid: 94063991e89fca1499cf00d3c8a3e160, type: 3}
  m_Name: "\uC720"
  m_EditorClassIdentifier: Assembly-CSharp::MemorialData
  memorialName: "\uC720"
  id: 7
  contents:
  - images: {fileID: 21300000, guid: 07e2987b5ad1976449bb756503b6ae1e, type: 3}
    descriptions:
    - "(\uB208\uC744 \uAC10\uACE0, \uB2F9\uC2E0\uC740....)"
  - images: {fileID: 21300000, guid: 7f0edacfc92129c48b1e8a2f171ce981, type: 3}
    descriptions:
    - "\"\uBBFF\uB294\uAC8C \uC544\uB2C8\uC5C8\uC5B4.\"\r\n\"\uBD84\uBA85 \uBD88\uAC00\uB2A5\uD588\uC744\uD150\uB370...\"\r\n\"\uAC10\uD788..
      \uB098\uB97C \uC774\uC6A9\uD574?\""
    - "(\uB2F9\uC2E0\uC740, \uC544\uB2C8 \uC720\uB294 \uBD84\uB178\uD558\uC5EC \uC120\uC655\uACFC
      \uADF8\uC758 \uC655\uC790\uC5D0\uAC8C \uACF5\uACA9\uC744 \uC900\uBE44\uD558\uC600\uB2E4.)\r\n(\uC61B
      \uCE5C\uAD6C\uB97C \uC190\uC218 \uCC98\uB2E8\uD558\uB824\uB294 \uADF8\uB140\uC758
      \uC190\uC740,)\r\n(\uBD84\uBA85\uD788 \uB5A8\uB9AC\uACE0 \uC788\uC5C8\uB2E4.)"
    - "\"\uC544\uB4E4\uC544... \uBA3C\uC800 \uB3C4\uB9DD\uCE58\uAC70\uB77C.\"\r\n(\uC120\uC655\uC740
      \uC655\uC790\uB97C \uC800 \uBA40\uB9AC \uBC00\uCCD0\uB0B4\uACE0 \uADF8\uB140
      \uC55E\uC73C\uB85C \uB2E4\uAC00\uAC14\uB2E4.)"
  - images: {fileID: 21300000, guid: 07e2987b5ad1976449bb756503b6ae1e, type: 3}
    descriptions:
    - "(\uC190 \uB05D\uC5D0 \uBAA8\uB4E0 \uAC10\uAC01\uC774 \uC0AC\uB77C\uC84C\uB2E4.)\r\n(\uB208
      \uC55E\uC744 \uC5B4\uB460\uC774 \uAC00\uB9AC\uAE30 \uC2DC\uC791\uD588\uB2E4.)"
    - "(\uC720\uB294 \uB208\uC744 \uB5A0 \uAC11\uC791\uC2A4\uB7F0 \uC0C1\uD669\uC5D0
      \uC801\uC751\uD558\uB824 \uB178\uB825\uD588\uB2E4.)\r\n(\uD76C\uBBF8\uD55C
      \uADE0\uC5F4 \uD2C8\uC0C8\uB85C, \uAC00\uC99D\uC2A4\uB7F0 \uC120\uC655\uACFC.)\r\n(\uC790\uC2E0\uC744
      \uAC00\uB450\uAE30 \uC704\uD574 \uAC1C\uC870\uB41C \uC790\uC2E0\uC774 \uC900
      \uC120\uBB3C,)\r\n(\uB610 \uB2E4\uB978 \uC790\uC2E0\uC774 \uC11C \uC788\uC5C8\uB2E4.)"
    - "(....)\r\n(\uB2F9\uC2E0\uC740 \uB208\uC744 \uB5A0 \uAE30\uC5B5\uC5D0\uC11C
      \uBC1C\uC744 \uBE7C\uB0B8\uB2E4.)"
