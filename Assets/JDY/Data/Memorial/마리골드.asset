  m_Script: {fileID: 11500000, guid: 94063991e89fca1499cf00d3c8a3e160, type: 3}
  m_Name: "\uB9C8\uB9AC\uACE8\uB4DC"
  m_EditorClassIdentifier: Assembly-CSharp::MemorialData
  memorialName: "\uB9C8\uB9AC\uACE8\uB4DC"
  id: 2
  contents:
  - images: {fileID: 21300000, guid: 07e2987b5ad1976449bb756503b6ae1e, type: 3}
    descriptions:
    - "(\uB208\uC744 \uAC10\uACE0, \uB2F9\uC2E0\uC740 \uB9C8\uB9AC\uACE8\uB4DC\uC758
      \uAE30\uC5B5 \uD55C\uD3B8\uC744 \uB4E4\uC5EC\uB2E4 \uBCF8\uB2E4.)"
  - images: {fileID: 21300000, guid: c1c284e42e3d0c44c83384a43f29b6cf, type: 3}
    descriptions:
    - "(\uB2F9\uC2E0\uC740, \uC544\uB2C8 \uB9C8\uB9AC\uACE8\uB4DC\uB294 \uBB34\uB300
      \uB4A4\uC5D0\uC11C \uCC28\uB840\uB97C \uAE30\uB2E4\uB838\uB2E4.)\r\n\"\uC774\uBD10....
      \uC774\uBC88\uC5D0\uB294 \uC2E4\uC218\uAC19\uC740\uAC74 \uC5C6\uB294\uAC70\uC9C0?\"\r\n\"\uC790\uB124..
      \uC774\uBC88\uC5D0\uB3C4 \uD391\uD06C\uB0B4\uBA74 \uB354 \uC774\uC0C1 \uBD88\uB7EC\uC904
      \uC218 \uC5C6\uC5B4.\"\r\n(\uC9C0\uB09C\uBC88\uC5D0\uB294 \uC2DC\uAC04\uC744
      \uCC29\uAC01\uD574 \uACF5\uC5F0\uC7A5\uC5D0 3\uC2DC\uAC04\uC744 \uB2A6\uC5C8\uC9C0\uB9CC,)\r\n(\uC774\uBC88\uC5D0\uB294
      \uADF8\uB7F0 \uCD08\uC9DC\uAC19\uC740 \uC2E4\uC218\uB294 \uD558\uC9C0 \uC54A\uB294\uB2E4.)\r\n(\uD06C\uAC8C
      \uD55C\uBC88 \uC228\uC744 \uB4E4\uC774\uC26C\uACE0,)\r\n(\uB2F9\uC2E0\uC740
      \uD3C9\uC18C\uAC19\uC9C0 \uC54A\uC740 \uAC00\uBCBC\uC6B4 \uB290\uB08C\uC73C\uB85C
      \uBB34\uB300 \uC704\uC5D0 \uC62C\uB790\uB2E4.)\r\n(....)\r\n(........)\r\n(\uC545\uAE30\uB97C
      \uB450\uACE0 \uC654\uB2E4.)"
  - images: {fileID: 21300000, guid: 07e2987b5ad1976449bb756503b6ae1e, type: 3}
    descriptions:
    - "(....)\r\n(\uB2F9\uC2E0\uC740 \uD5C8\uBB34\uD568\uC5D0 \uBAB8\uC774 \uAD73\uC5C8\uB2E4.)\r\n(\uBB34\uC5B8\uAC00
      \uB300\uB2E8\uD55C \uC774\uC57C\uAE30\uB97C \uAE30\uB300\uD55C \uB2F9\uC2E0\uC740)\r\n(\uB2F9\uC7A5\uC774\uB77C\uB3C4
      \uC606\uC5D0\uC11C \uCF67\uB178\uB798\uB97C \uD765\uC5BC\uAC70\uB9AC\uB294
      \uC800 \uC5BC\uBE75\uD55C \uC0AC\uC2E0\uC744 \uCE58\uACE0 \uC2F6\uC5C8\uB2E4.)\r\n(....)\r\n(\uB2F9\uC2E0\uC740
      \uB208\uC744 \uB5A0 \uD55C\uD3B8\uC758 \uAE30\uC5B5\uC5D0\uC11C \uBC1C\uC744
      \uBE7C\uB0C8\uB2E4.)"
