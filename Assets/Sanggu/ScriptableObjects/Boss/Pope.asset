  m_Script: {fileID: 11500000, guid: 5c2e1a687b6b43e586ded7e13e879765, type: 3}
  m_Name: Pope
  m_EditorClassIdentifier: Assembly-CSharp::BossTemp
  bossName: "\uAD50\uD669"
  bossId: pope
  bossSprite: {fileID: 21300000, guid: aca2dc3c25e6d084cbfd95a7d4fb9b01, type: 3}
  battleStart: "\uADF8\uB987\uB41C \uBBFF\uC74C\uC774 \uB2F9\uC2E0\uC744 \uB9C8\uC8FC\uD558\uACE0
    \uC788\uB2E4."
  turnStart:
  - "\u201C\uC8FD\uC74C\uC758 \uC885\uBCF5\uC774 \uAC10\uD788 \uC131\uC5ED\uC5D0
    \uBC1C\uC744 \uB4E4\uC774\uB294\uAC00.\u201D"
  - "\u201C\uBCF4\uC544\uB77C, \uC0AC\uC2E0\uC774\uC5EC. \uADF8\uB300 \uC5C6\uC774\uB3C4
    \uC6B0\uB9AC\uB294 \uC601\uC6D0\uC5D0 \uB3C4\uB2EC\uD558\uC600\uB2E4.\u201D"
  - "\u201C\uC8FD\uC74C\uC740 \uC774\uBBF8 \uD328\uBC30\uD588\uB2E4. \uADF8 \uC794\uC7AC\uC778
    \uB124\uAC00 \uBB34\uC5C7\uC744 \uD560 \uC218 \uC788\uACA0\uB290\uB0D0.\u201D"
  - "(\uB2F9\uC2E0\uC740 \uC0AC\uBA85\uAC10\uC73C\uB85C \uAC00\uB4DD \uCC3C\uB2E4.)"
  willDecline:
  - "\u201C\uC721\uC2E0\uC774 \uD754\uB4E4\uB9B0\uB2E4\uACE0 \uBBFF\uC74C\uAE4C\uC9C0
    \uD754\uB4E4\uB9B4 \uAC83 \uAC19\uC73C\uB0D0.\u201D"
  - "\u201C\uC774 \uB610\uD55C \uB098\uC758 \uC2E0\uC559\uC744 \uC99D\uBA85\uD560
    \uC2DC\uB828\uC77C \uBFD0.\u201D"
  - "(\uC12C\uB729\uD55C \uB9D0\uC744 \uC74A\uC870\uB9AC\uACE0 \uC788\uB2E4.)"
  - "\"\uBD88\uACBD\uD558\uB3C4\uB2E4!!\""
  willZero:
  - "\u201C\uC774 \uC721\uC2E0\uC774\u2026 \uAC10\uD788 \uB098\uB97C \uAC70\uC2A4\uB974\uB294\uAD70.\u201D"
  - "\u201C\uBE44\uCF1C\uB77C\u2026 \uC544\uC9C1 \uC2EC\uD310\uC740 \uB05D\uB098\uC9C0
    \uC54A\uC558\uB2E4\u2026\u2026.\u201D"
  - "\u201C\uACE0\uC791 \uC774 \uC815\uB3C4\uB85C\u2026 \uC601\uC6D0\uC744 \uAEBE\uC5C8\uB2E4
    \uC0DD\uAC01\uD558\uC9C0 \uB9C8\uB77C\u2026\u2026.\u201D"
  - "\"\uC73C\uC544\uC544\uC544\u2026!! \uC870\uAE08\uB9CC\u2026 \uC870\uAE08\uB9CC
    \uB354..!\""
  phaseTwo:
  - "\u201C\uC544\uC9C1\uB3C4 \uAE68\uB2EB\uC9C0 \uBABB\uD588\uB294\uAC00.\u201D"
  - "\u201C\uB124 \uBCF8\uBD84\uC740 \uC8FD\uC740 \uC790\uB97C \uAC70\uB450\uB294
    \uAC83. \uC774\uACF3\uC5D0\uB294 \uB124 \uC77C\uC774 \uC5C6\uB2E4.\u201D"
  - "\u201C\uAC10\uD788 \uAE30\uC801\uC744 \uBD80\uC815\uD558\uACE0\uB3C4 \uBB34\uC0AC\uD560
    \uC904 \uC54C\uC558\uB290\uB0D0!\u201D"
  - "\u201C\uC2E0\uAED8\uC11C \uCE68\uBB35\uD558\uC2E0\uB2E4 \uD55C\uB4E4 \uBB34\uC2A8
    \uC0C1\uAD00\uC778\uAC00! \uAE30\uC801\uC740 \uC774\uBBF8 \uC6B0\uB9AC \uC55E\uC5D0
    \uC788\uB2E4!\u201D"
  phaseThree:
  - "\u201C\uC601\uC6D0 \uC55E\uC5D0 \uC5CE\uB4DC\uB824\uB77C!\u201D"
  - "\u201C\uC0AC\uB77C\uC9C4 \uC8FD\uC74C\uACFC \uD568\uAED8 \uB108\uD76C \uB610\uD55C
    \uC78A\uD790 \uAC83\uC774\uB2E4.\u201D"
  - "\u201C\uB124\uAC00 \uC12C\uAE30\uB294 \uC9C8\uC11C\uB294 \uC774\uBBF8 \uB05D\uB0AC\uB2E4!\u201D"
  - "\u201C\uBCF4\uC544\uB77C! \uC774\uAC83\uC774 \uC8FD\uC74C\uC744 \uCD08\uC6D4\uD55C
    \uC790\uC758 \uBAA8\uC2B5\uC774\uB2E4!\u201D"
  attackedAP:
  - "\u201C\u2026\u2026\uAC74\uBC29\uC9C4.\u201D"
  - "\u201C\uADF8 \uC624\uB9CC\uC758 \uB300\uAC00\uB97C \uCE58\uB974\uAC8C \uD574\uC8FC\uB9C8.\u201D"
  - "\"\uAC10\uD788\u2026!\""
  - "\"\uB098 \uB610\uD55C \uADF8\uB300\uB4E4\uC744 \uC2EC\uD310\uD558\uB9AC\uB77C\u2026!\""
  attackedAD:
  - "\u201C\uD558\uCC2E\uC740 \uBC1C\uC545\uC774\uAD70.\u201D"
  - "\u201C\uADF8\uAC83\uC774 \uC0AC\uC2E0\uC758 \uD798\uC778\uAC00?\u201D"
  - "\u201C\uACA8\uC6B0 \uADF8 \uC815\uB3C4\uB0D0.\u201D"
  - "\"\uBD80\uC9C8\uC5C6\uB3C4\uB2E4.\""
  attack:
  - "\u201C\uBB34\uB98E \uAFC7\uC5B4\uB77C.\u201D"
  - "\u201C\uACBD\uBC30\uD558\uB77C, \uC601\uC6D0\uC744.\u201D"
  - "\u201C\uC2EC\uD310\uC744 \uBC1B\uC544\uB77C!\u201D"
  - "\u201C\uBD88\uACBD\uD55C \uC790\uC5EC!\u201D"
  win: "\u201C\uC5B4\uB9AC\uC11D\uAD6C\uB098\u2026 \uC601\uC6D0\uC740 \uC774\uBBF8
    \uC2DC\uC791\uB418\uC5C8\uB2E4. \uB124\uAC00 \uB418\uB3CC\uB9B4 \uC218 \uC788\uC744
    \uAC83 \uAC19\uC73C\uB0D0.\u201D"
  lose: "\u201C\uBCF4\uC558\uB290\uB0D0. \uC8FD\uC74C\uC870\uCC28 \uC601\uC6D0 \uC55E\uC5D0\uC11C\uB294
    \uBB34\uB98E \uAFC7\uB294\uB2E4.\u201D"
  distinctText:
  - "(\uBD88\uAE38\uD55C \uBE5B\uC774 \uBC14\uB2E5\uC5D0\uC11C \uC19F\uC544\uB098\uACE0
    \uC788\uB2E4.)"
  stageName: "\uC131\uB2F9"
  stageSprite: {fileID: 0}
