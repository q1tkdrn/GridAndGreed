  m_Script: {fileID: 11500000, guid: 5c2e1a687b6b43e586ded7e13e879765, type: 3}
  m_Name: Death2
  m_EditorClassIdentifier: Assembly-CSharp::BossTemp
  bossName: "\uC8FD\uC74C"
  bossId: death2
  bossSprite: {fileID: 21300000, guid: 05c8556d12989d04baed29c2e3de7632, type: 3}
  battleStart: "\u201C\u2026\u2026\uC5EC\uAE30\uAE4C\uC9C0 \uC54C\uC544\uB0C8\uAD6C\uB098.\u201D\n\"\u2026\"\n\"\uBB50\u2026
    \uBC14\uB85C \uC2DC\uC791\uD560\uAE4C?\"\n\u2026\n\uB2F9\uC2E0\uC740 \uB0AB\uC744
    \uAC15\uD558\uAC8C \uC6C0\uCF1C\uC950\uC5C8\uB2E4."
  turnStart:
  - "\"\uBB38\uC744 \uC783\uC740 \uC790\uAC00 \uB2E4\uC2DC \uBB38\uC744 \uBC14\uB77C\uB9AC\uB77C.\""
  - "\"\uADF8\uB294 \uC655\uC758 \uB208\uC55E\uC5D0 \uC8FD\uC74C\uC758 \uD754\uC801\uC744
    \uB193\uC73C\uB9AC\uB77C.\""
  - "\"\uC8FD\uC74C\uC744 \uB450\uB824\uC6CC\uD558\uC9C0 \uC54A\uC740 \uC655\uC740
    \uB9C8\uCE68\uB0B4 \uC8FD\uC74C\uACFC \uBC97\uC774 \uB418\uB9AC\uB77C.\""
  - "\"\uC8FD\uC74C\uC740 \uBC97\uC5D0\uAC8C \uC790\uC2E0\uC758 \uADF8\uB9BC\uC790\uB97C
    \uB098\uB204\uC5B4 \uC8FC\uB9AC\uB77C.\""
  - "\"\uC655\uC740 \uADF8\uB9BC\uC790 \uC18D\uC5D0\uC11C \uC8FD\uC740 \uC790\uC758
    \uBB38\uC744 \uBC1C\uACAC\uD558\uB9AC\uB77C.\""
  - "\"\uC8FD\uC740 \uC790\uC758 \uBB38\uC740 \uB4A4\uC9D1\uD600 \uC0B0 \uC790\uB97C
    \uC0BC\uD0A4\uB9AC\uB77C.\""
  - "\"\uBC30\uC2E0\uC744 \uC548 \uC8FD\uC74C\uC740 \uC655\uC758 \uB545\uC73C\uB85C
    \uB0B4\uB824\uC624\uB9AC\uB77C.\""
  - "\"\uC655\uC740 \uBC97\uC5D0\uAC8C\uC11C \uBC30\uC6B4 \uBC95\uCE59\uC73C\uB85C
    \uC8FD\uC74C\uC744 \uAC00\uB450\uB9AC\uB77C.\""
  - "\"\uC8FC\uC778\uC744 \uC783\uC740 \uADF8\uB9BC\uC790\uAC00 \uC8FD\uC74C\uC758
    \uC774\uB984\uC744 \uC774\uC5B4\uBC1B\uC73C\uB9AC\uB77C.\""
  - "\u201C\uADF8\uB9AC\uACE0 \uBB38\uC744 \uC783\uC740 \uC790\uB294, \uBAA8\uB4E0
    \uAC83\uC774 \uB05D\uB09C \uB4A4\uC5D0\uB3C4 \uC790\uC2E0\uC758 \uB54C\uB97C
    \uAE30\uB2E4\uB9AC\uB9AC\uB77C.\u201D"
  willDecline:
  - "\u201C\uC81C\uBC95\uC774\uB124. \uD558\uB098\uCBE4\uC740 \uB2FF\uC744 \uC904
    \uC54C\uC558\uB294\uB370.\u201D"
  - "\u201C\uB0B4 \uC6C0\uC9C1\uC784\uC744 \uC77D\uC740 \uAC70\uB2C8?\u201D"
  - "\u201C\uD6C4\uD6C4\u2026 \uB9CE\uC774 \uC131\uC7A5\uD588\uAD6C\uB098.\u201D"
  - "\u201C\uB2E4\uC74C\uC5D0\uB3C4 \uADF8\uB807\uAC8C \uD53C\uD560 \uC218 \uC788\uC744\uAE4C?\u201D"
  willZero:
  - "\u201C\uC774 \uC815\uB3C4\uB85C \uBAB0\uB9B4 \uC904\uC740 \uBAB0\uB790\uB294\uB370.\u201D"
  - "\u201C\u2026\u2026\uD6CC\uB96D\uD558\uAD6C\uB098.\u201D"
  - "\u201C\uB0B4 \uACF5\uACA9\uC744 \uC804\uBD80 \uD758\uB824\uB0C8\uB124\u2026\u2026.\u201D"
  - "\u201C\uB0B4\uAC00 \uBE48\uD2C8\uC744 \uBCF4\uC774\uB2E4\uB2C8\u2026 \uC81C\uBC95\uC774\uC57C.\u201D"
  phaseTwo:
  - "\u201C\uB124\uAC00 \uBB34\uC5C7\uC744 \uC758\uC2EC\uD558\uB294\uC9C0\uB294 \uC548\uB2E4.
    \uADF8\uB798\uB3C4 \uC9C0\uAE08\uC740 \uB3CC\uC544\uAC00\uB834.\u201D"
  - "\u201C\u2026\u2026\uC774\uC0C1\uD558\uAD6C\uB098. \uBD84\uBA85 \uCC98\uC74C
    \uB4E3\uB294 \uC774\uC57C\uAE30\uC778\uB370.\u201D"
  - "\"\uB0B4 \uAE30\uC5B5\uC5D0\uB294 \uC5B8\uC81C\uB098 \uC124\uBA85\uD560 \uC218
    \uC5C6\uB294 \uBE48\uC790\uB9AC\uAC00 \uC788\uC5C8\uC9C0.\u201D"
  - "\u201C\uC65C \uB2E4\uC74C \uC774\uC57C\uAE30\uB97C\u2026 \uC774\uBBF8 \uC54C\uACE0
    \uC788\uB294 \uAC78\uAE4C.\u201D"
  phaseThree:
  - "\u201C\u2026\u2026\uADF8\uB9BC\uC790\uB294 \uB098\uC600\uAD6C\uB098.\u201D"
  - "\u201C\uADF8\uBD84\uC758 \uAE30\uC5B5\uC744 \uAC00\uC9C4 \uAC83\uACFC\u2026
    \uADF8\uBD84\uC73C\uB85C \uC0B4\uC544\uC628 \uAC83\uC740 \uB2E4\uB978 \uC77C\uC774\uC5C8\uC5B4.\u201D"
  - "\u201C\uB0B4\uAC00 \uC720\uAC00 \uC544\uB2C8\uB77C\uB294 \uAC74 \uC54C\uACA0\uB2E8\uB2E4.
    \uD558\uC9C0\uB9CC \uB0B4\uAC00 \uC0B4\uC544\uC628 \uC2DC\uAC04\uAE4C\uC9C0 \uAC70\uC9D3\uC740
    \uC544\uB2C8\uC796\uB2C8.\u201D"
  - "\"\u2026.\""
  attackedAP:
  - "\u201C\uAD1C\uCC2E\uB2E8\uB2E4.\u201D"
  - "\u201C\uC81C\uBC95\uC774\uAD6C\uB098.\u201D"
  - "\u201C\uB9CE\uC774 \uC131\uC7A5\uD588\uB124.\u201D"
  - "\u201C\uB9DD\uC124\uC774\uC9C0 \uC54A\uC544\uB3C4 \uB3FC.\u201D"
  attackedAD:
  - "\"\u2026\u2026 \uC815\uB9D0 \uB05D\uAE4C\uC9C0 \uAC08 \uC0DD\uAC01\uC774\uAD6C\uB098.\u201D"
  - "\"\uC774\uB7F0 \uAC10\uAC01\uB3C4 \uB0B4 \uAC83\uC774\uACA0\uC9C0?\u201D"
  - "\u201C\uADF8\uB9CC\uB450\uB77C\uACE0 \uD558\uBA74\u2026 \uBA48\uCDB0\uC904 \uAC70\uB2C8?\u201D"
  - "\"\u2026\u2026\uBBF8\uC548\uD574. \uC870\uAE08 \uBB34\uC11C\uC6CC\uC84C\uB098
    \uBD10.\u201D"
  attack:
  - "\u201C\uBB3C\uB7EC\uB098\uB834.\u201D"
  - "\u201C\uBBF8\uC548\uD558\uAD6C\uB098.\u201D"
  - "\u201C\uB354\uB294 \uB098\uC544\uAC00\uAC8C \uB458 \uC218 \uC5C6\uC5B4.\u201D"
  - "\u201C\uC7A0\uC2DC \uC26C\uACE0 \uC788\uC73C\uB834.\u201D"
  win: "\"\u2026\""
  lose: "\u201C\uAC71\uC815\uD558\uC9C0 \uB9C8\uB834. \uAE68\uC5B4\uB098\uBA74 \uBAA8\uB4E0
    \uAC8C \uB2E4\uC2DC \uD3C9\uC18C\uC640 \uAC19\uC744 \uAC70\uC57C.\u201D"
  distinctText: []
