  m_Script: {fileID: 11500000, guid: 5c2e1a687b6b43e586ded7e13e879765, type: 3}
  m_Name: King
  m_EditorClassIdentifier: Assembly-CSharp::BossTemp
  bossName: "\uC655"
  bossSprite: {fileID: 21300000, guid: 3aea029a354038f41a8c4ea49f0577c6, type: 3}
  size: {x: 0, y: 0}
  sizeOnCutScene: {x: 0, y: 0}
  battleStart: "\uAE38\uACE0 \uAE34 \uC5EC\uC815\uC758 \uB05D\uC774 \uB2E4\uAC00\uC654\uB2E4.\n\uC9C0\uAE08,
    \uC5EC\uAE30\uC11C, \uB208 \uC55E\uC758 \uC655\uC744 \uC774\uAE30\uACE0,\n\uC655\uAD6D\uC744
    \uACE0\uD1B5\uC5D0\uC11C \uD574\uBC29\uD558\uC790.\n\"\u2026..\uC654\uB294\uAC00.
    \uC5B8\uC820\uAC00\uB294 \uADF8\uB300\uC640 \uB9C8\uC8FC\uD558\uAC8C \uB420 \uC904
    \uC54C\uC558\uB2E4.\"\n\u201C\uADF8\uB300\uAC00 \uC774\uACF3\uC5D0 \uC628 \uC774\uC720\uB3C4,
    \uB0B4\uAC00 \uADF8\uB300\uB97C \uB9C9\uC544\uC57C \uD558\uB294 \uC774\uC720\uB3C4
    \uC54C\uACE0 \uC788\uB2E4.\u201D\n\"\uC9C0\uAE08 \uC640\uC11C \uB9D0\uB85C \uB05D\uB0B4\uB294\uAC74
    \uC870\uAE08\uC740 \uD798\uB4E4\uB2E4\uB294\uAC78 \uC54C\uACE0 \uC788\uB124.\"\n\"\uADF8\uB798\uB3C4\u2026\"\n\"\uC544\uB2C8\uB2E4.
    \uADF8\uB300\uB3C4 \uADF8\uB300\uC758 \uC5ED\uD560\uC5D0 \uCD5C\uC120\uC744 \uB2E4
    \uD558\uAC8C.\"\n\"\uC9D0 \uB610\uD55C \uADF8\uB300\uB97C \uC9C4\uC2EC\uC73C\uB85C
    \uC0C1\uB300\uD558\uACA0\uB178\uB77C.\"\n\"\uC544. \uCC38\uACE0\uB85C\"\n\"\uC9D0\uC740
    \uACF5\uC815\uD55C \uC2F8\uC6C0\uC744 \uC88B\uC544\uD558\uB294\uC9C0\uB77C..\"\n\"\uC790\uB124\uC758
    \uB3D9\uB8CC\uB4E4\uC5D0\uAC8C\uB3C4 '\uC8FD\uC74C'\uC744 \uAC70\uB450\uC5B4
    \uC8FC\uACA0\uB124.\"\n\"\uB2E4\uB9CC, \uADF8 \uC9D0\uC740 \uC790\uB124\uAC00
    \uAC10\uB2F9\uD574\uC57C \uD560 \uAC83\uC774\uC57C.\""
  turnStart:
  - "\"\uC9D0\uC5D0\uAC8C \uD558\uACE0 \uC2F6\uC740 \uB9D0\uC774 \uB9CE\uACA0\uC9C0.\"\\n\"\uB098
    \uB610\uD55C \uADF8\uB300\uC5D0\uAC8C \uD558\uACE0 \uC2F6\uC740 \uB9D0\uC774
    \uB9CE\uB2E4\uB124.\""
  - "(\uC601\uC0DD\uC744 \uCAD3\uB358 \uC655\uC740 \uD5C8\uACF5\uC744 \uC751\uC2DC\uD558\uACE0
    \uC788\uB2E4.)"
  - "(\uD22C\uC9C0\uC640 \uACB0\uC758\uB85C \uAC00\uB4DD \uCC2C \uACF5\uAE30\uAC00
    \uC54C\uD604\uC2E4\uC744 \uB9F4\uB3CC\uACE0 \uC788\uB2E4.)"
  - "\"\uC8FD\uC74C\uC774 \uB2E4\uAC00\uC624\uB294\uAD6C\uB098.\""
  willDecline:
  - "\"\uD558\uD558\u2026\""
  - "\"\uC544\uC9C1\uC740 \uD3EC\uAE30\uD560 \uC218 \uC5C6\uB2E4\uB124.\""
  - "\"\uC120\uC655\uC774\uC2DC\uC5EC\u2026 \uC81C\uAC8C \uD798\uC744.\""
  - "\"\uC544\uBC84\uC9C0\u2026.\""
  willZero:
  - "\"\uC7A0\uC2DC \uC26C\uB3C4\uB85D \uD558\uACA0\uB124.\""
  - "\"\uC790\uB124\uB294 \uC5B4\uCC0C \uC9C0\uCE58\uC9C0 \uC54A\uB294\uAC00?\""
  - "\"\uC5B4\uB9B0 \uC0AC\uC2E0\uC774\uC5EC\u2026..\""
  - "\"\uB208 \uC55E\uC774 \uD750\uB824\uC9C0\uB294\uAD6C\uB098..\""
  phaseTwo:
  - "\"\uADF8\uB300\uC5D0\uAC8C \uC6D0\uD55C\uC740 \uC5C6\uB2E4\uB124.\""
  - "(\uBB34\uC5B8\uAC00 \uC791\uAC8C \uC18D\uC0AD\uC778\uB2E4.)"
  - "\"\uC870\uAE08 \uB354 \uD798\uC744 \uB0B4 \uBCF4\uACA0\uB124.\""
  - "\"\uC870\uAE08\uC740\u2026 \uAC00\uB2A5\uC131\uC774 \uBCF4\uC774\uB294\uAD6C\uB098.\""
  phaseThree:
  - "\u201C\uADF8\uB300\uC5D0\uAC8C \uC8FD\uC74C\uC740 \uC9C8\uC11C\uACA0\uC9C0.
    \uD558\uC9C0\uB9CC \uC6B0\uB9AC\uC5D0\uAC8C\uB294 \uB204\uAD70\uAC00\uB97C \uBE7C\uC557\uC544\uAC00\uB294
    \uC77C\uC774\uC5C8\uB2E4.\u201D"
  - "\u201C\uB0B4\uAC00 \uD2C0\uB838\uC744\uC9C0\uB3C4 \uBAA8\uB978\uB2E4. \uADF8\uB798\uB3C4\u2026
    \uB2E4\uC2DC \uADF8 \uC2DC\uC808\uB85C \uB3CC\uC544\uAC08 \uC218\uB294 \uC5C6\uC5B4.\u201D"
  - "\u201C\u2026\u2026\uC5EC\uAE30\uAE4C\uC9C0 \uC654\uC73C\uB2C8, \uC774\uC81C
    \uB9D0\uB85C\uB294 \uC11C\uB85C\uB97C \uC124\uB4DD\uD560 \uC218 \uC5C6\uACA0\uAD70.\u201D"
  - "(\uB9D0 \uC5C6\uC774 \uB2F9\uC2E0\uC744 \uC751\uC2DC\uD558\uACE0 \uC788\uB2E4.)"
  attackedAP:
  - "\u201C\uAD1C\uCC2E\uB124. \uACC4\uC18D\uD558\uAC8C.\u201D"
  - "\u201C\uADF8\uB300\uB3C4 \uBB3C\uB7EC\uC124 \uC218 \uC5C6\uACA0\uC9C0.\u201D"
  - "\u201C\uB9DD\uC124\uC77C \uD544\uC694 \uC5C6\uB124.\u201D"
  - "\"\uBAB8\uC774 \uAD73\uC5B4\uAC00\uB294\uAD6C\uB098..\""
  attackedAD:
  - "\u201C\uD06D\u2026\u2026 \uD6CC\uB96D\uD558\uAD70.\u201D"
  - "\u201C\uADF8 \uC815\uB3C4\uC758 \uAC01\uC624\uB85C \uC654\uB2E4\uB294 \uAC74\uAC00\u2026\u2026.\u201D"
  - "\u201C\u2026\u2026\uADF8\uB300 \uC5ED\uC2DC \uB9CE\uC740 \uAC83\uC744 \uAC78\uC5C8\uAD70.\u201D"
  - "\u201C\u2026\u2026\uB05D\uB0AC\uAD70.\u201D"
  attack:
  - "\u201C\uBBF8\uC548\uD558\uAD70.\u201D"
  - "\u201C\uBB3C\uB7EC\uB098\uAC8C.\u201D"
  - "\u201C\uC5EC\uAE30\uC11C \uB3CC\uC544\uAC00 \uC8FC\uAC8C.\u201D"
  - "\"\uBB3C\uB7EC\uC124 \uC0DD\uAC01\uC774 \uC5C6\uB2E4\uB294 \uAC74 \uB108\uBB34\uB098
    \uC798 \uC54C\uACE0 \uC788\uB124. \uADF8\uB798\uB3C4\u2026\""
  win: "\"\uC218\uACE0\uD588\uB124\u2026\uC815\uB9D0\uB85C.\"\n\"\u2026.\uADF8\uB798\uB3C4\"\n\"\uC870\uAE08\uC740
    \uAE30\uB300\uB294 \uD574 \uBCF4\uC558\uC9C0\uB9CC\u2026\"\n\"\uC5ED\uC2DC\u2026
    \"\n\"\uC5B4\uB9B0 \uC0AC\uC2E0\uC774\uC5EC..\"\n\"\uC774 \uC8FD\uC74C\uC744
    \uC55E\uB454 \uC778\uAC04\uACFC..\"\n\"\uC7A0\uC2DC \uC774\uC57C\uAE30\uB97C
    \uD558\uC9C0 \uC54A\uACA0\uB098?\""
  lose: "\"\uBBF8\uC548\uD558\uB124. \uADF8\uB300\uAC00 \uD2C0\uB838\uB2E4\uACE0
    \uC0DD\uAC01\uD574\uC11C \uC2F8\uC6B4 \uAC83\uC740 \uC544\uB2C8\uC5C8\uC5B4.\u201D\n\"\uADF8\uB7EC\uB2C8\u2026\"\n\"\uC27D\uAC8C
    \uD3EC\uAE30\uD558\uC9C4 \uB9D0\uC544\uC8FC\uAC8C..\"\n\"\uC9D0\uC740 \uC5EC\uAE30
    \uD56D\uC0C1 \uC788\uC73C\uB2C8.\""
  distinctText: []
  stageName: "\uC54C\uD604\uC2E4"
  stageSprite: {fileID: 0}
