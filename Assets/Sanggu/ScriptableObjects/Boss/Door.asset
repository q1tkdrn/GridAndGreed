  bossName: "\uBB38"
  bossSprite: {fileID: 21300000, guid: d3ab4c8e42a8d4d4b8e99267b9a204a8, type: 3}
  size: {x: 0, y: 0}
  sizeOnCutScene: {x: 0, y: 0}
  battleStart: "\uB2F9\uC2E0\uC740 \uC775\uC219\uD55C '\uBB38' \uC55E\uC5D0 \uC11C
    \uC788\uB2E4."
  turnStart:
  - "(\uC5EC\uAE30 \uC788\uC73C\uBA74 \uC548\uB418\uB294 \uAC83, \uC5B4\uC11C \uB418\uB3CC\uB9AC\uC790.)"
  - "(\uB2F9\uC2E0\uC740 \uAC1C\uC870\uB41C \uBB38\uC744 \uBCF4\uACE0 \uAC10\uD0C4\uC744
    \uD558\uC9C0 \uC54A\uC744 \uC218 \uC5C6\uC5C8\uB2E4.)"
  - "(\uC18C\uB984\uB07C\uCE58\uB294 \uBC14\uB78C \uC18C\uB9AC\uAC00 \uB4E4\uB9B0\uB2E4.)"
  - "(\uB2F9\uC2E0\uC740 \uC774 \uBB38\uC774 \uC65C \uC5EC\uAE30 \uC788\uB294\uC9C0
    \uC758\uBB38\uC774 \uB4E4\uAE30 \uC2DC\uC791\uD588\uB2E4.)"
  willDecline:
  - "(\uBBFF\uAE30 \uC5B4\uB835\uACA0\uC9C0\uB9CC, \uBB38\uC758 \uC758\uC9C0\uAC00
    \uAC10\uC18C\uD558\uC600\uB2E4.)"
  - "(\uB2F9\uC2E0\uC740 \uBB38\uC744 \uBCF4\uACE0 \uBB18\uD55C \uACF5\uD3EC\uC2EC\uC5D0
    \uC0AC\uB85C\uC7A1\uD614\uB2E4.)"
  - "(\uBB38 \uC8FC\uBCC0\uC758 \uBB34\uC5B8\uAC00\uB4E4\uC774 \uD798 \uC5C6\uC774
    \uB298\uC5B4\uC9C4\uB2E4.)"
  - "(\uB2F9\uC2E0\uC740 \uD76C\uB9DD\uC744 \uAC00\uC9C0\uAE30 \uC2DC\uC791\uD588\uB2E4.)"
  willZero:
  - "(\uB2F9\uC5F0\uD558\uC9C0\uB9CC, \uBB38\uC740 \uADF8 \uC790\uB9AC\uC5D0 \uBA48\uCDB0
    \uC11C \uC788\uB2E4.)"
  - "(\uB2F9\uC2E0\uC744 \uC625\uC8C4\uC5EC \uC624\uB358 \uBB18\uD55C \uB4A4\uD2C0\uB9BC\uC774
    \uC7A0\uC2DC \uC0AC\uB77C\uC84C\uB2E4.)"
  - "(\uB2F9\uC2E0\uC740 \uB0AB\uC744 \uACE0\uCCD0 \uC950\uC5C8\uB2E4.)"
  - "(\uACE0\uC9C0\uAC00 \uB208 \uC55E\uC774\uB2E4.)"
  phaseTwo:
  - "(\uACF5\uACA9\uC5D0 \uC775\uC219\uD574\uC9C0\uAE30\uB3C4 \uC804\uC5D0, \uC804\uC7A5\uC758
    \uAE30\uB958\uAC00 \uBC14\uB00C\uC5C8\uB2E4.)"
  - "(\uC775\uC219\uD55C \uBB38\uC758 \uC775\uC219\uD558\uC9C0 \uC54A\uC740 \uACF5\uACA9\uC5D0
    \uACA8\uC6B0 \uC775\uC219\uD574\uC84C\uC9C0\uB9CC, \uACB0\uAD6D \uBCC0\uD654\uB97C
    \uB9DE\uC774\uD558\uACE0 \uB9D0\uC558\uB2E4.)"
  - "(\uC775\uC219\uD574\uC9C0\uB294\uB370 \uC2DC\uAC04\uC774 \uC880 \uAC78\uB838\uC9C0\uB9CC,
    \uB2F9\uC2E0\uC740 \uBB38\uC758 \uC0C8\uB85C\uC6B4 \uACF5\uACA9\uC744 \uC801\uC751\uD560
    \uC900\uBE44\uAC00 \uB418\uC5C8\uB2E4.)"
  - "(\uC2DC\uAC04\uC774 \uC5C6\uB2E4.)"
  phaseThree:
  - "(\uBB38 \uD2C8\uC774 \uB354\uC6B1 \uB354 \uBC8C\uC5B4\uC9C0\uACE0 \uC788\uB2E4.)"
  - "(\uC804\uC7A5\uC5D0 \uC775\uC219\uD558\uC9C0 \uC54A\uC740 \uAE30\uB958\uAC00
    \uB610 \uB2E4\uC2DC \uD750\uB978\uB2E4.)"
  - "(\uC0C8\uB85C\uC6B4 \uACF5\uACA9\uC744 \uB2F9\uC2E0\uC740 \uBCF8\uB2A5\uC801\uC73C\uB85C
    \uC54C\uC544\uCC58\uB2E4.)"
  - "(\uC870\uAE08\uB9CC.. \uC544\uC8FC \uC870\uAE08 \uB0A8\uC558\uB2E4.)"
  attackedAP:
  - "(\uB2F9\uC2E0\uC740 \uC788\uB294 \uD798\uAECF '\uBB38'\uC744 \uC2EC\uD310\uD558\uC600\uB2E4.)"
  - "(\uBB38\uC758 \uB208\uB3D9\uC790\uAC00 \uD754\uB4E4\uB9B0\uB2E4.)"
  - "(\uAD34\uC0C1\uD55C \uC18C\uC74C\uC774 \uC804\uC7A5\uC744 \uAC00\uB4DD \uCC44\uC6B0\uACE0
    \uC788\uB2E4.)"
  - "(\uBB38 \uC8FC\uBCC0\uC758 \uC190\uC774 \uACA9\uB82C\uD558\uAC8C \uBAB8\uBD80\uB9BC\uCE5C\uB2E4.)"
  attackedAD:
  - "(\uB2F9\uC2E0\uC740 \uC788\uB294 \uD798\uAECF '\uBB38'\uC744 \uACF5\uACA9\uD558\uC600\uB2E4.)"
  - "(\uB2F9\uC5F0\uD55C \uC0AC\uC2E4\uC774\uC9C0\uB9CC, \uC774 \uBB38\uC740 \uAF64\uB098
    \uACAC\uACE0\uD558\uB2E4.)"
  - "(\uC9C1\uAC10\uC801\uC73C\uB85C, \uC774 \uBB38\uC744 \uB418\uB3CC\uB9B4 \uC218
    \uC5C6\uB2E4\uB294 \uAC78 \uB2F9\uC2E0\uC740 \uB290\uAF08\uB2E4.)"
  - "(\uBB38 \uC8FC\uBCC0\uC5D0 \uD759\uBA3C\uC9C0\uAC00 \uD53C\uC5B4\uC624\uB978\uB2E4.)"
  attack:
  - "(\uAE30\uBD84\uB098\uC05C \uAE30\uB958\uAC00 \uB2F9\uC2E0\uC744 \uB36E\uCCD0\uC628\uB2E4.)"
  - "(\uC775\uC219\uD55C \uBB38\uC740 \uB2F9\uC2E0\uC5D0\uAC8C \uC775\uC219\uD558\uC9C0
    \uC54A\uC740 \uACF5\uACA9\uC744 \uAC00\uD588\uB2E4!)"
  - "(\uC774\uC81C\uB294 \uADF8 \uBD88\uCF8C\uD55C \uAE30\uB958\uC870\uCC28 \uC775\uC219\uD574\uC9C4\uB2E4.)"
  - "(\uBB38 \uD2C8\uC0C8\uAC00 \uBC1D\uAC8C \uBE5B\uB098\uACE0 \uC788\uB2E4.)"
  win: "(\uBB38\uC740 \uD615\uCCB4\uB97C \uB0A8\uAE30\uC9C0 \uC54A\uACE0 \uBB34\uB108\uC84C\uB2E4.)"
  lose: "(\uC544\uC9C1 \uB2F9\uC2E0\uC740 \uD328\uBC30\uC5D0 \uC775\uC219\uD558\uC9C0
    \uC54A\uC9C0\uB9CC, \uC5B8\uC820\uAC00\uB294 \uC775\uC219\uD574\uC9C8 \uAC83\uC774\uB2E4.)"
  distinctText:
  - "\uB2F9\uC2E0\uC740 \uC775\uC219\uD55C \uC804\uC7A5\uC758 \uC775\uC219\uD558\uC9C0
    \uC54A\uC740 \uC704\uCE58\uB85C \uBCF4\uB0B4\uC84C\uB2E4."
  stageName: "\uC655\uC2E4\uC5F0\uAD6C\uC18C"
  stageSprite: {fileID: 0}
